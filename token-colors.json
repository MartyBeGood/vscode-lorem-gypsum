[
  {
    "name": "Comments",
    "scope": [
      "comment",
      "punctuation.definition.comment"
    ],
    "settings": {
      "foreground": "$comment"
    }
  },
  {
    "name": "Strings",
    "scope": [
      "string",
      "string.regexp",
      "punctuation.definition.string",
      "constant.other.symbol"
    ],
    "settings": {
      "foreground": "$string"
    }
  },
  {
    "name": "Strings: Escape Sequences",
    "scope": "constant.character.escape",
    "settings": {
      "foreground": "$escape"
    }
  },
  {
    "name": "Numbers, Characters",
    "scope": [
      "constant.numeric",
      "constant.character",
      "constant.keyword",
      "constant",
      "variable.other.constant",
      "support.type.property-name"
    ],
    "settings": {
      "foreground": "$constant"
    }
  },
  {
    "name": "Global definitions",
    "scope": [
      "entity.name"
    ],
    "settings": {
      "foreground": "$entityName"
    }
  },
  {
    "name": "Invalid",
    "scope": "invalid",
    "settings": {
      "foreground": "$invalid"
    }
  },
  {
    "name": "Bold text",
    "scope": "strong",
    "settings": {
      "fontStyle": "bold"
    }
  },
  {
    "name": "Keywords",
    "scope": "keyword",
    "settings": {
      "foreground": "$keyword"
    }
  },
  {
    "name": "Diff: inserted",
    "scope": "markup.inserted",
    "settings": {
      "foreground": "$diffInserted"
    }
  },
  {
    "name": "Diff: deleted",
    "scope": "markup.deleted",
    "settings": {
      "foreground": "$diffRemoved"
    }
  },
  {
    "name": "Diff: header",
    "scope": "meta.diff.header",
    "settings": {
      "foreground": "$diffHeader"
    }
  },
  {
    "name": "Magit: commit/stash entities",
    "scope": "magit.entity",
    "settings": {
      "foreground": "$constant"
    }
  }
]